DATABASE_URL: "postgresql://mock_user:mock_pass@localhost:5432/mock_db"
SHADOW_DATABASE_URL: "postgresql://mock_user:mock_pass@localhost:5432/mock_shadow_db"

# URL pública de la app (la del navegador). Debe coincidir con el header Origin
# y con las URLs de callback registradas en GitHub y Google.
APP_URL: "http://localhost:3000"

# Better Auth: secreto para firmar sesiones. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET: "reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres"

# GitHub OAuth App. Callback: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID: ""
GITHUB_CLIENT_SECRET: ""

# Google OAuth Client (aplicación web). Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID: ""
GOOGLE_CLIENT_SECRET: ""
